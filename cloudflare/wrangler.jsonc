{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ccb-bi",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ccb-bi",
      "database_id": "f2d2323c-b55a-4412-9697-1e5c86bf1854",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "BI · Jovens e Menores",
    "LOCAL_PADRAO": "Batistini",
    "ESTADO_PADRAO": "São Paulo",
    "CIDADE_PADRAO": "São Bernardo Do Campo",
    "PAIS_PADRAO": "Brasil"
  }
}
